% doto-minimal.sty - Minimal LaTeX theme for doto Sphinx extension

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{doto-minimal}[2024/01/01 Doto minimal styling for Sphinx]

\RequirePackage{xcolor}
\RequirePackage{hyperref}

% Minimal colors
\definecolor{doto@accent}{HTML}{0d6efd}
\definecolor{doto@muted}{HTML}{6c757d}

% Simple task environment using quote
\newenvironment{dotobox}[1][]{%
  \begin{quote}
  \textbf{#1}\\
}{%
  \end{quote}
}

% Priority variants (all same in minimal)
\newenvironment{dotoboxlow}[1][]{\begin{dotobox}[#1]}{\end{dotobox}}
\newenvironment{dotoboxmedium}[1][]{\begin{dotobox}[#1]}{\end{dotobox}}
\newenvironment{dotoboxhigh}[1][]{\begin{dotobox}[#1]}{\end{dotobox}}
\newenvironment{dotoboxcritical}[1][]{\begin{dotobox}[#1]}{\end{dotobox}}

% Compact layout (Feature D): minimal keeps the same quote-based box for the
% compact variants; the compact body macros below provide the dense layout.
\newenvironment{dotoboxcompact}[1][]{\begin{quote}}{\end{quote}}
\newenvironment{dotoboxcompactlow}[1][]{\begin{dotoboxcompact}[#1]}{\end{dotoboxcompact}}
\newenvironment{dotoboxcompactmedium}[1][]{\begin{dotoboxcompact}[#1]}{\end{dotoboxcompact}}
\newenvironment{dotoboxcompacthigh}[1][]{\begin{dotoboxcompact}[#1]}{\end{dotoboxcompact}}
\newenvironment{dotoboxcompactcritical}[1][]{\begin{dotoboxcompact}[#1]}{\end{dotoboxcompact}}

% List environment
\newenvironment{dotolist}{%
  \begin{itemize}
}{%
  \end{itemize}
}

% Summary environment
\newenvironment{dotosummary}{%
  \begin{description}
}{%
  \end{description}
}

% Minimal formatting commands
\newcommand{\dotoid}[1]{\texttt{#1}}
\newcommand{\dotopriority}[1]{[#1]}
\newcommand{\dotostatus}[1]{(#1)}
\newcommand{\dotoassignee}[1]{@#1}
\newcommand{\dotodue}[1]{Due: #1}
\newcommand{\dototag}[1]{\##1}
\newcommand{\dotooverdue}[1]{\textbf{#1 -- OVERDUE}}
\newcommand{\dotoref}[1]{\hyperref[#1]{\texttt{#1}}}

% Compact-layout body macros (Feature D). Minimal renders them as plain text
% so the same compact fields appear without the tcolorbox styling.
\newcommand{\dotocompactheader}[4]{\textbf{#1} [#2] [#3] (#4)\\}
\newcommand{\dotocompactrule}{}
\newcommand{\dotocompactfield}[2]{#1 #2}
\newcommand{\dotocompactsep}{ \textbar\ }

\endinput
